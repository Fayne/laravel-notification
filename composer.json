{
    "name": "fayne/laravel-notification",
    "description": "This package is used to send notifications",
    "type": "library",
    "license": "Proprietary",
    "autoload": {
        "psr-4": {
            "Fayne\\LaravelNotification\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fayne\\LaravelNotification\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Fayne Guo",
            "email": "fayne.guo@gmail.com",
            "homepage": "https://github.com/Fayne"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "monolog/monolog": "^3.0",
        "overtrue/laravel-wechat": "^8.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fayne\\LaravelNotification\\NotificationServiceProvider"
            ],
            "aliases": {
                "AppChatSend": "Fayne\\LaravelNotification\\Facades\\AppChatSend",
                "Dingding": "Fayne\\LaravelNotification\\Facades\\Dingding"
            }
        }
    },
    "require-dev": {
        "laravel/pint": "^1.5",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "easywechat-composer/easywechat-composer": true
        }
    }
}
