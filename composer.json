{
    "name": "mobilenowgroup/laravel-notification",
    "description": "This package is used to send notifications",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "MobileNowGroup\\LaravelNotification\\": "src/"
        }
    },
    "authors": [
        {
            "name": "alisaxu",
            "email": "alisa.xu@mobilenowgroup.com"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "laravel/framework": "^8.0",
        "overtrue/laravel-wechat": "^6.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MobileNowGroup\\LaravelNotification\\NotificationServiceProvider"
            ],
            "aliases": {
                "AppChatSend": "MobileNowGroup\\LaravelNotification\\Facades\\AppChatSend",
                "Dingding": "MobileNowGroup\\LaravelNotification\\Facades\\Dingding"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "easywechat-composer/easywechat-composer": true
        }
    }
}
